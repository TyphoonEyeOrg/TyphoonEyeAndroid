<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (android:fullBackupContent).
   Android 12+ uses data_extraction_rules.xml; keep both in sync.
   See https://developer.android.com/guide/topics/data/autobackup

   User-entered data-source API keys (Settings → Custom data source keys) live in their own
   DataStore file and must never leave the device: excluded from backup.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/data_source_keys.preferences_pb" />
</full-backup-content>
