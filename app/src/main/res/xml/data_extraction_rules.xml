<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / transfer rules for Android 12+ (android:dataExtractionRules).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   User-entered data-source API keys (Settings → Custom data source keys) live in their own
   DataStore file and must never leave the device: excluded from both cloud backup and
   device-to-device transfer. Keep in sync with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/data_source_keys.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/data_source_keys.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
