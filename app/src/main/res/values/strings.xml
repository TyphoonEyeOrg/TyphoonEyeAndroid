    <string name="open_source_licenses_desc">Typhoon Eye is built with the following open-source projects. Special thanks to all maintainers:</string>
    <string name="oss_compose_desc">Official modern declarative UI toolkit and Material Design 3 component library for Android</string>
    <string name="oss_coroutines_desc">Asynchronous concurrency coroutines and high-performance cross-platform JSON serialization</string>
    <string name="oss_hilt_desc">Official recommended standardized dependency injection (DI) solution for Android</string>
    <string name="oss_maplibre_desc">Open-source cross-platform vector map rendering engine for typhoon tracks and wind radii</string>
    <string name="oss_retrofit_desc">Type-safe RESTful API client and low-level HTTP/2 network transport engine</string>
    <string name="oss_jetpack_desc">Local SQLite database persistence, reactive DataStore preferences, and background Live scheduling</string>
    <string name="oss_eddsa_desc">Ed25519 / EdDSA cryptographic signature algorithm implementation for QWeather API</string>
    <string name="oss_test_desc">Testing utility for Kotlin Flows and Mockito unit testing framework</string>

