## TyphoonEye — local.properties example
#
# Copy to project root as local.properties (gitignored).
# Without keys the app runs in demo / offline-cache mode.

# sdk.dir=/path/to/Android/sdk

# ---------- Juhe (optional live typhoon list / track) ----------
# https://www.juhe.cn/
# JUHE_KEY=

# ---------- QWeather (optional live typhoon + warnings) ----------
# Console: https://console.qweather.com/
# Default host is the public API. Use your dedicated host if you have one.
# QWEATHER_HOST=https://devapi.qweather.com/
#
# Recommended: EdDSA JWT. Used only when all four are set; then the API key is ignored.
# QWEATHER_KID=            credential ID (JWT header kid)
# QWEATHER_PROJECT_ID=     project ID (JWT sub)
# QWEATHER_DEVELOPER_ID=   developer ID, console → account (JWT iss)
# QWEATHER_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#
# Or API Key → X-QW-Api-Key (daily requests limited by QWeather from 2027-01-01)
# QWEATHER_API_KEY=

# ---------- Map (optional) ----------
# Mainland China basemap (Amap Web key): https://console.amap.com/dev/key/app
# AMAP_KEY=
# Force basemap at build time: auto | amap | open
# MAP_BASEMAP=auto
# MAPLIBRE_STYLE_URL=

# ---------- In-app updates (GitHub Releases) ----------
# GITHUB_OWNER=Seamain
# GITHUB_REPO=TyphoonEyeAndroid

# ---------- Version overrides (optional) ----------
# Prefer root version.properties for releases.
# VERSION_NAME=1.2.0
# VERSION_CODE=15

# ---------- Release signing (CI / local release) ----------
# RELEASE_STORE_FILE=release.keystore
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=
